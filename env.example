# Copy this file to `.env` if you're running a single persona from this checkout.
# If you're running multiple personas (e.g. larry_david and kramer) from the same
# checkout, instead copy it to `.env.<slug>` for each persona (e.g. `.env.larry_david`,
# `.env.kramer`) — the CLI loads the persona-specific file automatically when present.

# Bluesky API credentials
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=your-app-password

# API key for quote generation. You only need the one your character asks for:
# `provider: gemini` (the default) uses GEMINI_API_KEY, `provider: anthropic`
# uses ANTHROPIC_API_KEY, `provider: deepseek` uses DEEPSEEK_API_KEY,
# `provider: openai` uses OPENAI_API_KEY.
GEMINI_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# OPENAI_API_KEY=your-openai-api-key

# X/Twitter cross-posting is off by default, even if credentials are saved.
# To opt in, set X_ENABLED=true and fill in all five credentials below.
# Paid X API credits are required: https://console.x.com/
X_ENABLED=false
# TWITTER_BEARER_TOKEN=your-bearer-token-here
# TWITTER_API_KEY=your-api-key-here
# TWITTER_API_SECRET=your-api-secret-here
# TWITTER_ACCESS_TOKEN=your-access-token-here
# TWITTER_ACCESS_SECRET=your-access-secret-here
