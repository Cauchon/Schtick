[Unit]
Description=Schtick (%i)
After=network.target

[Service]
User=cauchon
WorkingDirectory=/home/cauchon/Larry-David-Bot
ExecStart=/home/cauchon/Larry-David-Bot/venv/bin/python -m schtick %i
Restart=always
RestartSec=10
# Load environment variables from .env.<slug> file (optional; leading '-' means
# systemd won't fail if the file is missing)
EnvironmentFile=-/home/cauchon/Larry-David-Bot/.env.%i

[Install]
WantedBy=multi-user.target
